<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Q Inspect"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BACKEND URL"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://xxxx.trycloudflare.com"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:background="#1A233A"
            android:padding="14dp"
            android:inputType="textUri"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save URL"
            android:layout_marginTop="8dp"
            android:backgroundTint="#232F4A"
            android:textColor="#F8FAFC" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷  SCAN QR CODE"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:backgroundTint="#06B6D4"
            android:textColor="#04121A" />

        <TextView
            android:id="@+id/verdictText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/payloadText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="#121826"
            android:padding="12dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/indicatorsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:paddingBottom="30dp" />

    </LinearLayout>
</ScrollView>
