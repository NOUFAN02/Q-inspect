# Q Inspect — configuration template.
# Copy this file to ".env" and fill in your values. The real .env is gitignored.

# VirusTotal API v3 key (free tier). https://www.virustotal.com -> API key
QI_VT_API_KEY=

# Optional: route outbound scanning through Tor (anonymised egress).
# Start Tor Browser (listens on 127.0.0.1:9150), then set:
# QI_PROXY=socks5://127.0.0.1:9150
